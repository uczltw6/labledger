# Copy this file to .env and replace placeholders locally. Never commit .env.
APP_ENV=<dev>
AWS_PROFILE=<aws-cli-profile>
AWS_REGION=<aws-region>
BEDROCK_MODEL_ID=<bedrock-model-id>
BEDROCK_EMBEDDING_MODEL_ID=<bedrock-embedding-model-id>
EMBEDDING_DIM=<embedding-dimension>
COCKROACH_DATABASE_URL=<cockroachdb-connection-string>
COCKROACHDB_CLUSTER_ID=<cockroachdb-cluster-id>
COCKROACH_MCP_URL=<https://cockroachlabs.cloud/mcp>
COCKROACH_MCP_API_KEY=<runtime-only-service-account-api-key>
S3_BUCKET=<private-artifact-bucket-name>
FRONTEND_ORIGIN=<http://localhost:5173>
